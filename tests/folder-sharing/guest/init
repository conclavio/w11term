#!/bin/sh
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C
exec </dev/console >/dev/console 2>&1
trap 'echo "W11TERM_GUEST_STOP status=$?"; /bin/busybox poweroff -f' EXIT
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /run
mkdir -p /dev/pts /dev/shm /run/sshd
mount -t devpts -o gid=5,mode=0620,ptmxmode=0666 devpts /dev/pts
ln -sfn pts/ptmx /dev/ptmx
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
while read -r module; do /bin/busybox insmod "/boot/modules/$module"; done </boot/modules/load-order
fw=/sys/firmware/qemu_fw_cfg/by_name/opt/w11term/authorized_key/raw
for _ in $(seq 1 100); do
    if [ -r "$fw" ] && [ -e /sys/class/net/eth0 ] && [ -c /dev/fuse ]; then break; fi
    sleep 0.1
done
test -r "$fw"
test -c /dev/fuse
# No udev is started in this initramfs. Apply the ordinary FUSE device mode.
chmod 0666 /dev/fuse
ip link set lo up
ip addr add 10.0.2.15/24 dev eth0
ip link set eth0 up
ip route add default via 10.0.2.2 dev eth0

# Consume only the run's public Ed25519 key from the read-only QEMU firmware
# channel. No credentials, host shares or networking are needed to provision it.
tr -d '\r' <"$fw" > /run/w11term-client.pub
read -r kind blob _ </run/w11term-client.pub || test -n "${blob:-}"
test "$kind" = ssh-ed25519
case $blob in ''|*[!A-Za-z0-9+/=]*) echo "Invalid fixture public key" >&2; exit 1;; esac
auth=/home/w11fixture/.ssh
install -d -m 0700 -o w11fixture -g w11fixture "$auth"
printf 'ssh-ed25519 %s\n' "$blob" >"$auth/authorized_keys"
ssh-keygen -lf "$auth/authorized_keys" >/dev/null
chmod 0600 "$auth/authorized_keys"
chown w11fixture:w11fixture "$auth/authorized_keys"

ssh-keygen -q -t ed25519 -N '' -f /run/w11term-host-ed25519
ssh-keygen -q -t ed25519 -N '' -f /run/w11term-host-ca
ssh-keygen -q -s /run/w11term-host-ca -I w11term-fixture -h -n 127.0.0.1 \
    -V -5m:+1h /run/w11term-host-ed25519.pub
/usr/sbin/sshd -t -f /etc/ssh/w11term-fixture.conf
/usr/sbin/sshd -D -e -f /etc/ssh/w11term-fixture.conf &
server=$!
for _ in $(seq 1 100); do
    kill -0 "$server"
    if ss -H -lnt 'sport = :22' | grep -q .; then
        read -r kind blob _ </run/w11term-host-ca.pub
        printf 'W11TERM_SSH_HOST_CA %s %s\n' "$kind" "$blob"
        read -r kind blob _ </run/w11term-host-ed25519.pub
        printf 'W11TERM_SSH_HOST_KEY %s %s\n' "$kind" "$blob"
        wait "$server"
        exit 0
    fi
    sleep 0.1
done
echo "SSH did not listen on port 22" >&2
exit 1
